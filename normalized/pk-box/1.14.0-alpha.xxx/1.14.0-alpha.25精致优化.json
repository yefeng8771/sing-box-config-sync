      },
      {
        "outbound": "smart-proxy",
        "rule_set": [
          "fcm",
          "Android"
        ]
      },
      {
        "outbound": "smart-proxy",
        "rule_set": [
          "geosite-google",
          "geosite-youtube",
          "telegram",
          "instagram",
          "Google",
          "Proxy",
          "gfw",
          "ai",
          "games",
          "GlobalMedia",
          "telegram_ip",
          "telegramip"
        ]
      },
      {
        "outbound": "smart-proxy",
        "package_name_regex": "^(com\\.google\\.android\\.(youtube|apps\\.(maps|docs|drive))|app\\.revanced\\.android\\.youtube|org\\.telegram\\.(messenger|group)(\\..*)?)$"
      },
      {
        "outbound": "direct",
        "rule_set": [
          "private",
          "cn",
          "cnip",
          "microsoft-cn",
          "apple-cn",
          "games-cn",
          "networktest"
        ]
      },
      {
        "domain_suffix": "sponsor.ajay.app",
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "package_name": [
          "com.tencent.mm",
          "com.eg.android.AlipayGphone",
          "com.netease.cloudmusic",
          "com.wwwscn.yuexingbao"
        ]
      },
