    "rules": [
      {
        "domain_suffix": "cp.cloudflare.com",
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "type": "logical"
      },
      {
        "action": "reject",
        "port": [
          853,
          5353
        ]
      },
      {
        "action": "reject",
        "mode": "and",
        "rules": [
          {
            "ip_version": 6
          },
          {
            "default_interface_address": "2000::/3",
            "invert": true
          }
        ],
        "type": "logical"
      },
      {
        "outbound": "direct",
        "protocol": [
          "ntp",
          "icmp"
        ]
      },
      {
        "domain_suffix": [
          "google.cn",
          "googleapis.cn"
        ],
        "outbound": "smart-proxy"
      },
      {
        "domain_suffix": [
          "browserleaks.com",
          "ipleak.net",
          "dnsleaktest.com",
          "whoer.net",
          "whatleaks.com",
          "ip.sb",
          "ipinfo.io",
          "ifconfig.me",
