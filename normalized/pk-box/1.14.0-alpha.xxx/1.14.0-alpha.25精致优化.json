        "outbound": "direct",
        "rule_set": "Apple"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "smart-proxy"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "ip_cidr": "198.18.0.0/15",
        "outbound": "smart-proxy"
      },
      {
        "action": "route-options",
        "udp_connect": true,
        "udp_disable_domain_unmapping": true
      },
      {
        "action": "reject",
        "method": "drop",
        "rule_set": [
          "Ads",
          "httpDNS",
          "DNSreject",
          "anti_fraud"
        ]
      },
      {
        "action": "reject",
        "domain": [
          "beacon.qq.com",
          "abyss.cyapi.cn",
          "ad.cyapi.cn",
          "gather.colorfulclouds.net"
        ],
        "method": "drop"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite_adguard",
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "reject",
        "protocol": [
          "stun",
          "quic",
          "dtls"
        ]
      },
      {
        "action": "reject",
        "mode": "or",
        "rules": [
          {
            "network": "udp",
            "port": [
              3478,
              5349,
              5350,
              19302,
              10000
            ]
          },
          {
            "domain_regex": "^stun\\..+"
          },
          {
            "domain_keyword": [
              "stun",
              "turn",
              "httpdns"
            ]
          }
        ],
        "type": "logical"
      },
      {
        "action": "resolve"
      }
