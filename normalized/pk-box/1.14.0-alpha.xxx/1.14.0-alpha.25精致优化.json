{
  "dns": {
    "cache_capacity": 256000,
    "final": "proxy-dns",
    "optimistic": {
      "enabled": true,
      "timeout": "1h0m0s"
    },
    "reverse_mapping": true,
    "rules": [
      {
        "action": "reject",
        "query_type": [
          "SVCB",
          "HTTPS",
          "PTR"
        ]
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite_adguard",
          "geosite-category-ads-all",
          "DNSreject"
        ]
      },
      {
        "action": "reject",
        "domain_suffix": ".local"
      },
      {
        "rule_set": "Filter",
        "server": "alidns-quic"
      },
      {
        "server": "fakeip"
      }
    ],
    "servers": [
      {
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ]
        },
        "tag": "hosts_fix",
        "type": "hosts"
      },
      {
        "detour": "direct",
        "domain_resolver": "hosts_fix",
        "server": "dns.alidns.com",
        "tag": "alidns-quic",
        "type": "quic"
      },
      {
        "detour": "smart-proxy",
        "domain_resolver": "hosts_fix",
        "server": "dns.google",
        "tag": "proxy-dns",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "fakeip",
        "type": "fakeip"
      }
    ],
    "strategy": "prefer_ipv4",
    "timeout": "3s"
  },
  "experimental": {
    "cache_file": {
      "cache_id": "cinchov",
      "enabled": true,
      "path": "cache.db",
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "default_mode": "rule",
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui"
    },
    "debug": {
      "gc_percent": 100,
      "memory_limit": "400MB"
    }
  },
  "http_clients": [
    {
      "connection_receive_window": 0,
      "detour": "direct",
      "stream_receive_window": 0,
      "tag": "default",
      "version": 2
    },
    {
      "connection_receive_window": 0,
      "detour": "smart-proxy",
      "domain_resolver": "alidns-quic",
      "stream_receive_window": 0,
      "tag": "proxy",
      "version": 2
    }
  ],
  "inbounds": [
    {
      "address": [
        "10.8.0.1/24",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "dns_address": [
        "10.8.0.2",
        "fdfe:dcba:9876::2"
      ],
      "dns_mode": "hijack",
      "mtu": 1400,
      "route_address_set": [
        "cnip",
        "private"
      ],
      "stack": "system",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "trace",
    "timestamp": true
  },
  "ntp": {
    "detour": "smart-proxy",
    "enabled": true,
    "interval": "30m0s",
    "server": "ntp.aliyun.com",
    "server_port": 123
  },
  "outbounds": [
    {
      "domain_resolver": "alidns-quic",
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    },
    {
      "default": "🟢 auto-select",
      "outbounds": [
        "🟢 auto-select",
        "🔵 stable-select"
      ],
      "tag": "smart-proxy",
      "type": "selector"
    },
    {
      "idle_timeout": "30m0s",
      "interval": "10m0s",
      "outbounds": [
        "pkpk01",
        "pkpk02",
        "pkpk03",
        "pkpk04",
        "pkpk05",
        "pkg01",
        "pkg02",
        "pkg03",
        "pkg04",
        "pkg05",
        "pkg06",
        "pkg07",
        "pkg08",
        "pkg09"
      ],
      "tag": "🟢 auto-select",
      "tolerance": 100,
      "type": "urltest",
      "url": "http://cp.cloudflare.com/generate_204"
    },
    {
      "idle_timeout": "1h0m0s",
      "interval": "15m0s",
      "outbounds": [
        "pkpk01",
        "pkpk02",
        "pkpk03",
        "pkpk04",
        "pkpk05",
        "pkg01",
        "pkg02",
        "pkg03",
        "pkg04",
        "pkg05",
        "pkg06",
        "pkg07",
        "pkg08",
        "pkg09"
      ],
      "tag": "🔵 stable-select",
      "tolerance": 30,
      "type": "urltest",
      "url": "http://cp.cloudflare.com/generate_204"
    }
  ],
