{
  "dns": {
    "final": "cloudflare",
    "optimistic": true,
    "rules": [
      {
        "action": "evaluate",
        "server": "cloudflare",
        "tag": "cf"
      },
      {
        "action": "evaluate",
        "server": "google",
        "tag": "gg"
      },
      {
        "action": "respond",
        "match_response": "cf",
        "race": true,
        "response_rcode": "NOERROR"
      },
      {
        "action": "respond",
        "match_response": "gg",
        "race": true,
        "response_rcode": "NOERROR"
      }
    ],
    "servers": [
      {
        "server": "1.1.1.1",
        "tag": "cloudflare",
        "type": "udp"
      },
      {
        "server": "8.8.8.8",
        "tag": "google",
        "type": "udp"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 443,
      "mode": "default",
      "psk": "",
      "tag": "snell-in",
      "tcp_fast_open": true,
      "tcp_multi_path": true,
      "type": "snell",
      "version": 6
    }
  ],
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "interval": "30m",
    "server": "time.apple.com",
    "server_port": 123
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "cloudflare"
    },
    "final": "direct",
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "snell-in"
        ]
      },
      {
        "action": "route-options",
        "inbound": [
          "snell-in"
        ],
        "udp_disable_domain_unmapping": true
      }
    ]
  }
}
