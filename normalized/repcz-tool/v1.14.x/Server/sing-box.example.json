{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "certificate_providers": [
    {
      "data_directory": "/var/lib/sing-box/acme",
      "domain": [
        "your_server_ip"
      ],
      "email": "admin@example.com",
      "key_type": "ed25519",
      "tag": "ip_cert",
      "type": "acme"
    }
  ],
  "dns": {
    "final": "cloudflare",
    "optimistic": true,
    "rules": [
      {
        "action": "evaluate",
        "server": "cloudflare",
        "tag": "cf"
      },
      {
        "action": "evaluate",
        "server": "google",
        "tag": "gg"
      },
      {
        "action": "respond",
        "match_response": "cf",
        "race": true,
        "response_rcode": "NOERROR"
      },
      {
        "action": "respond",
        "match_response": "gg",
        "race": true,
        "response_rcode": "NOERROR"
      }
    ],
    "servers": [
      {
        "server": "1.1.1.1",
        "tag": "cloudflare",
        "type": "udp"
      },
      {
        "server": "8.8.8.8",
        "tag": "google",
        "type": "udp"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 50443,
      "padding_scheme": [],
      "tag": "anytls-in",
      "tcp_fast_open": true,
      "tcp_multi_path": true,
      "tls": {
        "certificate_provider": "ip_cert",
        "enabled": true,
        "server_name": "your_server_ip"
      },
      "type": "anytls",
      "users": [
        {
          "name": "singbox",
          "password": ""
        }
      ]
    },
    {
      "down_mbps": 200,
      "ignore_client_bandwidth": false,
      "listen": "::",
      "listen_port": 51443,
      "masquerade": {
        "content": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Welcome to nginx!</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody {\n  font-family: Tahoma, Verdana, Arial, sans-serif;\n  background: #ecf0f1;\n  color: #2c3e50;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n}\n.container {\n  background: #fff;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px rgba(0,0,0,0.1);\n  padding: 40px 50px;\n  max-width: 600px;\n  text-align: center;\n}\nh1 {\n  font-size: 28px;\n  font-weight: 400;\n  color: #34495e;\n  margin-bottom: 10px;\n}\nh1 b { font-weight: 700; color: #e74c3c; }\np {\n  font-size: 14px;\n  line-height: 1.8;\n  color: #7f8c8d;\n  margin: 8px 0;\n}\n.code {\n  background: #f8f9fa;\n  border: 1px solid #e9ecef;\n  border-radius: 4px;\n  padding: 12px 16px;\n  font-family: Consolas, monospace;\n  font-size: 13px;\n  color: #2c3e50;\n  margin: 16px 0;\n  text-align: left;\n  word-break: break-all;\n}\nhr {\n  border: none;\n  border-top: 1px solid #eee;\n  margin: 20px 0;\n}\n.footer {\n  font-size: 12px;\n  color: #bdc3c7;\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h1><b>Welcome to nginx!</b></h1>\n<p>If you see this page, the nginx web server is successfully installed and working. Further configuration is required.</p>\n<p>For online documentation and support please refer to\n<a href=\"https://nginx.org/\">nginx.org</a>.<br/>\nCommercial support is available at\n<a href=\"https://nginx.com/\">nginx.com</a>.</p>\n<div class=\"code\">Server: nginx/1.24.0 (Ubuntu)<br>\nPort: 443</div>\n<hr>\n<div class=\"footer\">\n<em>Thank you for using nginx.</em>\n</div>\n</div>\n</body>\n</html>",
        "headers": {
          "Content-Type": [
            "text/html"
          ]
        },
        "status_code": 200,
        "type": "string"
      },
      "tag": "hy2-in",
      "tls": {
        "certificate_provider": "ip_cert",
        "enabled": true,
        "server_name": "your_server_ip"
      },
      "type": "hysteria2",
      "up_mbps": 200,
      "users": [
        {
          "name": "singbox",
          "password": ""
        }
      ]
    },
    {
      "listen": "::",
      "listen_port": 52443,
      "mode": "default",
      "psk": "",
      "tag": "snell-in",
      "tcp_fast_open": true,
      "tcp_multi_path": true,
      "type": "snell",
      "version": 6
    }
  ],
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "interval": "30m",
    "server": "time.apple.com",
    "server_port": 123
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "cloudflare"
    },
    "final": "direct",
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "anytls-in",
          "hy2-in",
          "snell-in"
        ]
      },
      {
        "action": "route-options",
        "inbound": [
          "anytls-in",
          "hy2-in",
          "snell-in"
        ],
        "udp_disable_domain_unmapping": true
      }
    ]
  }
}
