      {
        "action": "reject",
        "rule_set": [
          "Reject"
        ]
      },
      {
        "action": "reject",
        "query_type": [
          "HTTPS",
          "SVCB"
        ]
      },
      {
        "domain_suffix": [
          "lancache.steamcontent.com",
          "10099.com.cn",
          "msftconnecttest.com",
          "msftncsi.com",
          "local",
          "lan",
          "home",
          "internal",
          "corp",
