        "server": "local"
      },
      {
        "action": "route",
        "clash_mode": "Direct",
        "server": "local"
      },
      {
        "action": "route",
        "query_type": [
          "A",
          "AAAA"
        ],
        "rewrite_ttl": 1,
        "server": "fakeip"
      },
      {
        "action": "route",
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "action": "evaluate",
        "server": "ali-doh",
        "speculative": true,
        "tag": "ali"
      },
      {
        "action": "evaluate",
        "server": "tx-doh",
        "speculative": true,
        "tag": "tencent"
      },
      {
        "action": "reject",
        "ip_is_private": true,
        "match_response": "ali",
        "race": true
      },
      {
        "action": "reject",
        "ip_is_private": true,
        "match_response": "tencent",
        "race": true
      },
      {
        "action": "respond",
        "match_response": "ali",
        "race": true,
        "response_rcode": "NOERROR"
      },
      {
        "action": "respond",
        "match_response": "tencent",
        "race": true,
        "response_rcode": "NOERROR"
      }
    ],
