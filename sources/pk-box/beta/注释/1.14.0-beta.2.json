        "url": "https://cdn.jsdelivr.net/gh/senshinya/singbox_ruleset@main/rule/{tag}/{tag}.srs",
        // 解释：URL 模板，{tag} 会被替换。

        // ------ 第 177 行：update_interval —— 更新间隔 ------
        "update_interval": "48h0m0s"
        // 解释：每 48 小时更新。
      },

      // ---------------------------------------------------------------------
      // 规则集 3（索引 2）：gfw 规则集（从 MetaCubeX 仓库）
      // ---------------------------------------------------------------------
      {
        // ------ 第 178 行：type —— 规则集类型 ------
        "type": "remote",
        // 解释：远程规则集。

        // ------ 第 179 行：tag —— 规则集标签 ------
        "tag": "gfw",
        // 解释：标签为 gfw，表示 GFW 相关的域名列表。

        // ------ 第 180 行：url —— 下载 URL ------
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
        // 解释：从 MetaCubeX 仓库下载 GFW 规则集。
        // 注意：此规则集包含被 GFW 干扰的域名。

        // ------ 第 181 行：update_interval —— 更新间隔 ------
        "update_interval": "48h0m0s"
        // 解释：每 48 小时更新。
      },

      // ---------------------------------------------------------------------
      // 规则集 4（索引 3）：geosite_adguard 广告规则集
      // ---------------------------------------------------------------------
      {
        // ------ 第 182 行：type —— 规则集类型 ------
        "type": "remote",
        // 解释：远程规则集。

        // ------ 第 183 行：tag —— 规则集标签 ------
        "tag": "geosite_adguard",
        // 解释：标签为 geosite_adguard，表示来自 AdGuard 的广告域名列表。

        // ------ 第 184 行：url —— 下载 URL ------
        "url": "https://cdn.jsdelivr.net/gh/217heidai/adblockfilters@main/rules/adblocksingbox.srs",
        // 解释：从 217heidai 仓库下载 AdGuard 广告规则集。
        // 注意：这是自定义的广告过滤规则集。

        // ------ 第 185 行：update_interval —— 更新间隔 ------
        "update_interval": "48h0m0s"
        // 解释：每 48 小时更新。
      },

      // ---------------------------------------------------------------------
      // 规则集 5（索引 4）：geosite-category-ads-all 广告规则集
      // ---------------------------------------------------------------------
      {
        // ------ 第 186 行：type —— 规则集类型 ------
        "type": "remote",
        // 解释：远程规则集。

        // ------ 第 187 行：tag —— 规则集标签 ------
        "tag": "geosite-category-ads-all",
        // 解释：标签为 geosite-category-ads-all，来自 SagerNet 的 geosite 广告列表。

        // ------ 第 188 行：url —— 下载 URL ------
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
        // 解释：从 SagerNet 仓库下载完整的广告域名列表。

        // ------ 第 189 行：update_interval —— 更新间隔 ------
        "update_interval": "48h0m0s"
        // 解释：每 48 小时更新。
      }
    ],
    // rule_set 结束

    // -------- 第 190 行：final —— 最终默认出站 ------
    "final": "proxy",
    // 解释：当所有路由规则都不匹配时，使用 proxy 出站。
    // 目的：作为最后的兜底策略，确保未分类的流量走代理。
    // 注意：如果希望未分类的流量直连，可改为 "DIRECT"。

    // -------- 第 191 行：find_neighbor —— 查找邻居路由 ------
    "find_neighbor": true,
    // 解释：尝试查找邻居路由（用于某些网络环境）。
    // 目的：可能有助于某些网络配置，保持 true 通常无害。

    // -------- 第 192 行：auto_detect_interface —— 自动检测网络接口 ------
    "auto_detect_interface": true,
    // 解释：自动检测出口网络接口。
    // 目的：适应多网卡环境（如 Wi-Fi 和有线同时存在）。

    // -------- 第 193 行：default_domain_resolver —— 默认域名解析器 ------
    "default_domain_resolver": "cf-dns",
    // 解释：当路由规则中未指定 resolver 时，使用此 DNS 服务器。
    // 目的：为路由层面的解析提供默认 DNS。
    // 注意：通常保持与 DNS 配置一致。

    // -------- 第 194 行：default_http_client —— 默认 HTTP 客户端 ------
    "default_http_client": "default"
    // 解释：使用名为 "default" 的 HTTP 客户端配置。
    // 目的：与前面定义的 http_clients 关联。
  },
  // route 对象结束

  // =========================================================================
  // 第 195 行：experimental 对象开始 —— 实验性功能
  // =========================================================================
  "experimental": {
    // -------- 第 196 行：cache_file 对象开始 —— 缓存文件配置 --------
    "cache_file": {
      // ------ 第 197 行：enabled —— 是否启用缓存文件 ------
      "enabled": true,
      // 解释：启用缓存文件，将状态持久化到磁盘。
      // 目的：重启后能恢复状态，提高性能。

      // ------ 第 198 行：path —— 缓存文件路径 ------
      "path": "cache.db",
      // 解释：缓存数据库文件，相对路径，通常位于工作目录。
      // 目的：指定缓存存储位置。
      // 注意：如果使用绝对路径，需确保目录存在且有写权限。

      // ------ 第 199 行：store_fakeip —— 是否存储 FakeIP 映射 ------
      "store_fakeip": true,
      // 解释：持久化 FakeIP 分配记录。
      // 目的：重启后保持相同的 FakeIP 映射，避免重新分配导致连接断开。

      // ------ 第 200 行：store_dns —— 是否存储 DNS 缓存 ------
      "store_dns": true
      // 解释：持久化 DNS 缓存。
      // 目的：重启后仍命中 DNS 缓存，加速域名解析。
    }
    // cache_file 对象结束
  }
  // experimental 结束
}
// =========================================================================
// 完整配置结束。本配置实现了 TUN 模式下的全局代理，涵盖：
// 1. DNS 分流：国内用本地 DNS，国外用 DoH，广告用 reject，代理域名用 FakeIP
// 2. 路由分流：国内域名/IP 直连，代理域名走代理，FakeIP 段走代理
// 3. 安全加固：拒绝 IPv6、拒绝高危端口、拒绝可疑协议
// 4. 性能优化：DNS 缓存、乐观缓存、规则集自动更新
// 5. 注意：所有 "节点名称" 占位符需替换为实际节点标签
// 每条配置都已详细注释其作用、目的、注意事项和潜在疑问。
// =========================================================================
