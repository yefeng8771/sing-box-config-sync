{
  // =========================================================================
  // 第 1 行：$schema —— 声明配置遵循的 JSON Schema 版本
  // =========================================================================
  "$schema": "https://sing-box.sagernet.org/schema/1.14.0-beta.2.json",
  // 解释：这个字段声明了当前配置文件所遵循的 JSON Schema 版本，用于编辑器的语法校验和自动补全。
  // 目的：确保配置符合 sing-box 1.14.0-beta.2 的规范，避免因字段拼写错误或版本不匹配导致程序启动失败。
  // 注意：如果您使用的 sing-box 版本低于 1.14.0-beta.2，某些字段可能不被支持，建议升级程序或修改 schema 链接。
  // 疑惑：为什么不用最新版？因为稳定性和兼容性考虑，beta.2 是经过测试的版本。
  // 总结：这是一个元数据声明，不影响运行时行为，但有助于开发和调试。

  // =========================================================================
  // 第 2 行：log 对象开始 —— 日志配置
  // =========================================================================
  "log": {
    // -------- 第 3 行：level —— 日志级别 --------
    "level": "fatal",
    // 解释：设置日志输出级别为 fatal，即只记录导致程序崩溃的致命错误。
    // 可选值：trace、debug、info、warn、error、fatal、panic。
    // 目的：在生产环境中最大限度减少日志写入，降低磁盘 I/O 并避免敏感信息（如域名、IP）泄露。
    // 注意：调试时可以将级别临时改为 info 或 debug 以观察连接详情，但日常使用建议保持 fatal。
    // 疑惑：如果程序出错但未崩溃，fatal 不会记录，是否会遗漏问题？一般错误通过其他监控捕获，这里只关注致命故障。
    // 总结：根据运行环境调整，普通用户保持 fatal 即可。

    // -------- 第 4 行：timestamp —— 时间戳开关 --------
    "timestamp": true
    // 解释：是否在每条日志中记录时间戳（ISO 8601 格式）。
    // 目的：方便追踪事件发生的精确时间，便于问题定位和日志关联分析。
    // 注意：开启会增加日志体积，但通常可接受；关闭则日志更简洁，但排查困难。
    // 疑惑：如果日志量极大，时间戳会不会成为负担？现代存储和处理器可轻松应对，建议开启。
    // 总结：始终设为 true，除非有特殊性能要求。
  },

  // =========================================================================
  // 第 5 行：dns 对象开始 —— DNS 解析核心配置
  // =========================================================================
  "dns": {
    // -------- 第 6 行：servers 数组开始 —— DNS 服务器列表 --------
    "servers": [

      // =====================================================================
      // 服务器元素 1（索引 0）：hosts 类型服务器
      // =====================================================================
      {
        // ------ 第 7 行：type —— 服务器类型 ------
        "type": "hosts",
        // 解释：指定此 DNS 服务器类型为静态 hosts 文件模式。
        // 目的：提供一个只读的域名→IP 映射表，不进行递归查询，也不依赖外部网络。
        // 注意：此服务器仅返回 predefined 中定义的记录，其他域名查询会失败（但通常不会被路由到这里）。
        // 疑惑：为什么不直接使用操作系统的 hosts 文件？因为这里可以动态管理，且不影响系统全局配置。
        // 总结：用于硬编码关键 DNS 服务器的 IP 地址，防止启动时循环依赖。

        // ------ 第 8 行：tag —— 服务器标签 ------
        "tag": "hosts_fix",
        // 解释：为该 DNS 服务器分配一个唯一标签，供其他配置部分（如 domain_resolver）引用。
        // 目的：通过标签引用，避免重复写全称，也使配置更清晰。
        // 注意：标签必须在整个配置中唯一，否则会被覆盖。
        // 疑惑：标签可以任意命名吗？可以，但建议有实际意义，便于维护。
        // 总结：此标签专门用于解析外部 DoH 服务器的域名。

        // ------ 第 9 行：predefined 对象开始 —— 预定义映射表 ------
        "predefined": {
          // -------- 第 10 行：cloudflare-dns.com 映射 --------
          "cloudflare-dns.com": [
            "104.16.248.249",
            "104.16.249.249"
          ],
          // 解释：将域名 cloudflare-dns.com 映射到两个 IPv4 地址。
          // 目的：当需要解析该域名时，直接返回这两个 IP，不必发起外部查询，避免循环依赖。
          // 注意：这两个 IP 是 Cloudflare DoH 服务器的固定公共 IP，若有变动需手动更新。
          // 疑惑：为什么给两个 IP？为了容错，一个不可用时尝试另一个。
          // 总结：硬编码确保初始化阶段能成功连接 DoH 服务器。

          // -------- 第 11 行：dns.adguard.com 映射 --------
          "dns.adguard.com": [
            "94.140.14.15",
            "94.140.15.16"
          ],
          // 解释：AdGuard DNS 的 DoH 域名映射到其 IPv4 地址。
          // 目的：同样是为了避免循环依赖，保证 AdGuard DoH 服务可解析。
          // 注意：AdGuard 的 IP 地址也可能变化，但相对稳定。
          // 疑惑：如果这些 IP 失效怎么办？需要手动更新配置或使用其他备用。
          // 总结：静态映射是权衡稳定性和灵活性的选择。

          // -------- 第 12 行：dns.quad9.net 映射 --------
          "dns.quad9.net": [
            "9.9.9.9",
            "149.112.112.112"
          ]
          // 解释：Quad9 DNS 的 DoH 域名映射到其 IPv4 地址。
          // 目的：同上，保证 Quad9 域名解析可靠。
          // 注意：Quad9 也提供多个 IP，这里列出两个常用节点。
          // 疑惑：为什么不包含 IPv6？因为全局已禁用 IPv6，无需映射。
          // 总结：三个主流 DoH 服务器均被硬编码。
        }
        // predefined 对象结束
      },
      // 第一个服务器元素结束

      // =====================================================================
      // 服务器元素 2（索引 1）：local 类型服务器
      // =====================================================================
      {
        // ------ 第 13 行：type —— 服务器类型 ------
        "type": "local",
        // 解释：使用操作系统配置的本地 DNS 解析器（如 /etc/resolv.conf 或 Windows 的 DNS 设置）。
        // 目的：对于可信域名（国内网站、内网）提供最低延迟的解析，不经过代理或加密。
        // 注意：本地 DNS 可能被 ISP 劫持或污染，因此只用于非敏感域名。
        // 疑惑：为什么不都用 DoH？因为国内 CDN 需要返回离用户最近的 IP，本地 DNS 更准确。
        // 总结：是速度与安全平衡下的选择。

        // ------ 第 14 行：tag —— 服务器标签 ------
        "tag": "local-dns"
        // 解释：标签为 local-dns，用于在 DNS 规则中引用此服务器。
        // 目的：使规则可以明确指定使用本地解析。
        // 注意：标签要唯一。
        // 疑惑：如果本地 DNS 响应很慢，会影响整体吗？只针对特定规则，影响范围可控。
        // 总结：专用于国内/私有域名解析。
      },

      // =====================================================================
      // 服务器元素 3（索引 2）：fakeip 类型服务器
      // =====================================================================
      {
        // ------ 第 15 行：type —— 服务器类型 ------
        "type": "fakeip",
        // 解释：FakeIP 类型的 DNS 服务器，不会进行真实查询，而是为域名分配一个虚拟 IP 地址。
        // 目的：为需要代理的域名提供占位 IP，使得后续路由可以根据 IP 段（198.18.0.0/15）将这些流量导向代理。
        // 注意：FakeIP 本身不解析真实 IP，实际连接由代理 outbound 完成。
        // 疑惑：为什么不直接使用域名路由？因为某些应用不依赖 DNS，直接连接 IP，FakeIP 能统一处理。
        // 总结：这是 sing-box 实现域名级分流的经典方法。

        // ------ 第 16 行：tag —— 服务器标签 ------
        "tag": "fakeip",
        // 解释：标签为 fakeip，在 DNS 规则中，当需要代理的域名匹配时，使用此服务器。
        // 目的：与规则配合，明确哪些域名应获得 FakeIP。
        // 注意：此标签应与路由规则中的 IP CIDR 匹配。
        // 疑惑：标签和之前一样没关系吗？只要在服务器列表内唯一即可。
        // 总结：用于标记 FakeIP 分配器。

        // ------ 第 17 行：inet4_range —— FakeIP 地址池 ------
        "inet4_range": "198.18.0.0/15"
        // 解释：定义 FakeIP 使用的 IPv4 地址池，这里采用 RFC 2544 保留的测试地址段。
        // 目的：确保这些 IP 不会与任何真实公共 IP 或内网 IP 冲突。
        // 注意：此段在互联网不可路由，因此所有去往这些 IP 的流量都由本地路由规则处理。
        // 疑惑：/15 提供了约 131072 个地址，是否够用？通常绰绰有余。
        // 总结：专用段保证了安全性和隔离性。
      },

      // =====================================================================
      // 服务器元素 4（索引 3）：Cloudflare DoH（https 类型）
      // =====================================================================
      {
        // ------ 第 18 行：type —— 服务器类型 ------
        "type": "https",
        // 解释：指定使用 DNS over HTTPS（DoH）协议，通信加密，防窃听和篡改。
        // 目的：获得安全、私密的域名解析，避免 ISP 或中间人干扰。
        // 注意：DoH 请求通过 HTTP/2 或 HTTP/3 发送，默认路径为 /dns-query。
        // 疑惑：为什么不用 DoT？DoH 与现有 HTTP 基础设施兼容性更好。
        // 总结：这是现代加密 DNS 的主流选择。

        // ------ 第 19 行：tag —— 服务器标签 ------
        "tag": "cf-dns",
        // 解释：标签为 cf-dns，代表 Cloudflare DNS。
        // 目的：方便在 DNS 规则和默认解析器中引用。
        // 注意：标签应简洁易记。
        // 疑惑：cf 是 Cloudflare 的缩写，大家常见。
        // 总结：标识性标签。

        // ------ 第 20 行：detour —— 绕路出站 ------
        "detour": "proxy",
        // 解释：指定此 DNS 服务器发出的查询请求本身要经过哪个出站（outbound）。
        // 目的：使 DoH 请求也走代理，防止 ISP 对 DoH 端口或 IP 进行封锁或干扰。
        // 注意：如果代理不可用，此 DNS 将无法工作，因此需要备用方案（如 fallback 规则）。
        // 疑惑：如果代理本身需要 DNS 解析才能连接，会不会死循环？不，因为代理的域名解析会走 hosts_fix。
        // 总结：detour 是确保 DoH 可达性的关键。

        // ------ 第 21 行：domain_resolver —— 域名解析器 ------
        "domain_resolver": "hosts_fix",
        // 解释：在解析此 DoH 服务器自身的域名（cloudflare-dns.com）时，使用哪个 DNS 服务器。
        // 目的：通过 hosts_fix 直接返回硬编码的 IP，避免走外部 DNS 导致循环依赖。
        // 注意：hosts_fix 必须包含该域名的映射，否则解析失败。
        // 疑惑：为什么不直接用 IP 地址？域名更灵活，支持负载均衡。
        // 总结：解决"先有鸡还是先有蛋"的问题。

        // ------ 第 22 行：server —— DoH 服务器域名 ------
        "server": "cloudflare-dns.com"
        // 解释：DoH 服务器的域名，sing-box 会自动在其后添加 /dns-query 路径。
        // 目的：指定实际的 DoH 服务端点。
        // 注意：该域名必须能被 domain_resolver 解析。
        // 疑惑：如果域名被墙怎么办？由于走代理且用 hosts 硬编码，通常不会。
        // 总结：指定目标 DoH 服务。
      },

      // =====================================================================
      // 服务器元素 5（索引 4）：AdGuard DoH（https 类型）
      // =====================================================================
      {
        // ------ 第 23 行：type —— 服务器类型 ------
        "type": "https",
        // 解释：同样为 DoH 类型，加密传输。
        // 目的：使用 AdGuard 的公共 DoH 服务，其附带广告过滤和恶意域名拦截功能。
        // 注意：AdGuard 的过滤策略可能与本地规则集重叠，但无害。
        // 疑惑：AdGuard 和 Cloudflare 有何不同？AdGuard 更侧重于过滤，Cloudflare 更中立。
        // 总结：根据用途选择。

        // ------ 第 24 行：tag —— 服务器标签 ------
        "tag": "adguard-dns",
        // 解释：标签为 adguard-dns，便于在广告相关的 DNS 规则中引用。
        // 目的：与其他服务器区分，便于维护。
        // 注意：标签不重复。
        // 疑惑：为什么不用更短的标签？因为 adguard 已足够。
        // 总结：标识 AdGuard 服务。

        // ------ 第 25 行：detour —— 绕路出站 ------
        "detour": "proxy",
        // 解释：此 DNS 查询也走代理，与前面的理由相同。
        // 目的：保护 DoH 请求不被干扰。
        // 注意：依赖代理可用性。
        // 疑惑：如果代理类型不同，是否影响？不影响，只要 outbound 标签为 proxy。
        // 总结：确保隐蔽性。

        // ------ 第 26 行：domain_resolver —— 域名解析器 ------
        "domain_resolver": "hosts_fix",
        // 解释：解析 dns.adguard.com 时使用 hosts_fix。
        // 目的：避免循环依赖。
        // 注意：hosts_fix 中已有该域名映射。
        // 疑惑：如果 hosts_fix 中没有怎么办？会失败，所以必须添加。
        // 总结：保持一致性。

        // ------ 第 27 行：server —— DoH 服务器域名 ------
        "server": "dns.adguard.com"
        // 解释：AdGuard 的 DoH 域名。
        // 目的：指定服务端点。
        // 注意：同上。
        // 疑惑：AdGuard 也有多 IP，hosts 已给出。
        // 总结：指定目标。
      },

      // =====================================================================
      // 服务器元素 6（索引 5）：Quad9 DoH（https 类型）
      // =====================================================================
      {
        // ------ 第 28 行：type —— 服务器类型 ------
        "type": "https",
        // 解释：DoH 类型，加密传输。
        // 目的：使用 Quad9 的加密 DNS，其以隐私保护和威胁情报闻名。
        // 注意：Quad9 也会过滤恶意域名。
        // 疑惑：Quad9 与 AdGuard 都过滤，是否重复？多重过滤提高可靠性。
        // 总结：补充选择。

        // ------ 第 29 行：tag —— 服务器标签 ------
        "tag": "quad9-doh",
        // 解释：标签 quad9-doh。
        // 目的：用于规则引用。
        // 注意：唯一性。
        // 疑惑：为什么用 doh 后缀？明确标识是 DoH 协议。
        // 总结：标识。

        // ------ 第 30 行：detour —— 绕路出站 ------
        "detour": "proxy",
        // 解释：走代理。
        // 目的：防干扰。
        // 注意：依赖代理。
        // 疑惑：如果代理不通，Quad9 也无法使用，但有其他 DNS 作为后备。
        // 总结：确保安全。

        // ------ 第 31 行：domain_resolver —— 域名解析器 ------
        "domain_resolver": "hosts_fix",
        // 解释：使用 hosts_fix 解析 dns.quad9.net。
        // 目的：避免循环。
        // 注意：hosts_fix 中有对应条目。
        // 疑惑：如果 hosts_fix 中没写，会导致失败，所以必须写。
        // 总结：一致策略。

        // ------ 第 32 行：server —— DoH 服务器域名 ------
        "server": "dns.quad9.net"
        // 解释：Quad9 DoH 域名。
        // 目的：指定服务。
        // 注意：同上。
        // 疑惑：Quad9 的 IP 是否稳定？基本稳定。
        // 总结：指定目标。
      }
      // servers 数组结束
    ],

    // -------- 第 33 行：rules 数组开始 —— DNS 规则列表 --------
    "rules": [
      // =====================================================================
      // DNS 规则 1（索引 0）：使用规则集拒绝广告/恶意域名
      // =====================================================================
      {
        // ------ 第 34 行：rule_set（数组） —— 匹配的规则集 ------
        "rule_set": [
          "BlockHttpDNS",
          "AdGuardSDNSFilter",
          "ads"
        ],
        // 解释：当查询的域名匹配这三个规则集中的任意一个时，触发本规则。
        // 目的：在 DNS 层直接拦截广告、追踪、恶意以及 HTTP DNS 探测请求。
        // 注意：这些规则集需要从远程加载（见 route.rule_set）。
        // 疑惑：为什么有三个？因为来源不同，覆盖面更全，互补。
        // 总结：多重拦截保障。

        // ------ 第 35 行：action —— 执行的动作 ------
        "action": "reject"
        // 解释：执行拒绝动作，返回 NXDOMAIN（域名不存在）响应。
        // 目的：使客户端无法获得该域名的 IP，从而阻止连接。
        // 注意：reject 比返回 0.0.0.0 更彻底，不会产生任何地址。
        // 疑惑：如果客户端缓存了之前的记录，是否还能连接？缓存过期后会被拒绝。
        // 总结：有效阻断不良域名。
      },

      // =====================================================================
      // DNS 规则 2（索引 1）：拒绝 AAAA 查询
      // =====================================================================
      {
        // ------ 第 36 行：query_type —— 查询类型 ------
        "query_type": "AAAA",
        // 解释：匹配所有请求 IPv6 地址的 DNS 查询。
        // 目的：强制客户端仅使用 IPv4，避免 IPv6 网络不稳定或代理不支持 IPv6 导致的问题。
        // 注意：这会影响所有域名的 AAAA 查询，全局生效。
        // 疑惑：如果某个应用必须使用 IPv6 怎么办？可以移除此规则或添加例外。
        // 总结：简化网络环境。

        // ------ 第 37 行：action —— 执行的动作 ------
        "action": "reject"
        // 解释：拒绝该查询，不返回任何 AAAA 记录。
        // 目的：使客户端 fallback 到 A 查询（IPv4）。
        // 注意：某些客户端可能会因此增加延迟，但通常可接受。
        // 疑惑：如果客户端强制要求 IPv6，连接会失败，但大多数应用支持 IPv4。
        // 总结：强制执行 IPv4。
      },

      // =====================================================================
      // DNS 规则 3（索引 2）：拒绝 SVCB/HTTPS/PTR 查询类型
      // =====================================================================
      {
        // ------ 第 38 行：query_type（数组） —— 查询类型列表 ------
        "query_type": [
          "SVCB",
          "HTTPS",
          "PTR"
        ],
        // 解释：匹配 SVCB（服务绑定）、HTTPS（特定服务绑定）和 PTR（反向解析）记录。
        // 目的：减少不必要的 DNS 查询类型，降低处理开销。
        // 注意：这些类型在现代网络中使用较少，拒绝通常不影响正常浏览。
        // 疑惑：HTTPS 记录用于 HTTP/3 发现，拒绝可能影响某些新协议的协商，但罕见。
        // 总结：优化性能。

        // ------ 第 39 行：action —— 执行的动作 ------
        "action": "reject"
        // 解释：拒绝这些查询类型。
        // 目的：同上。
        // 注意：如果某些应用需要这些记录，可能出错，需调整。
        // 疑惑：如何知道哪些应用需要？通常无需担心。
        // 总结：精简 DNS 流量。
      },

      // =====================================================================
      // DNS 规则 4（索引 3）：限制仅允许 A 和 AAAA（取反）
      // =====================================================================
      {
        // ------ 第 40 行：query_type（数组） —— 允许的查询类型 ------
        "query_type": [
          "A",
          "AAAA"
        ],
        // 解释：定义允许的查询类型为 A 和 AAAA。
        // 目的：配合 invert 实现白名单，只允许这两种类型。
        // 注意：AAAA 已被上一条拒绝，因此实际只允许 A。

