{
  // =========================================================================
  // 第 1 行：$schema — JSON Schema 声明
  // =========================================================================
  // 这不是 sing-box 必需的配置项，而是给编辑器（如 VSCode）用的
  // 作用：让编辑器能够提供自动补全、语法校验、字段提示等功能[reference:1]
  // 如果你不使用支持 JSON Schema 的编辑器，这一行可以完全删除
  "$schema": "https://sing-box.sagernet.org/schemas/config.json",

  // =========================================================================
  // 第 2 行开始：log — 日志配置模块
  // =========================================================================
  // log 对象控制 sing-box 运行时输出日志的详细程度和格式
  // 日志对于排查问题、调试规则、观察流量走向至关重要
  "log": {

    // 第 3 行：level — 日志级别
    // 可选值（按详细程度从高到低）：
    //   trace  — 最详细，输出所有调试信息（每个连接、每个 DNS 查询、每个数据包）
    //   debug  — 调试级别，比 trace 少一些内部细节
    //   info   — 信息级别（默认），只输出重要的运行信息
    //   warn   — 警告级别，仅输出警告和错误
    //   error  — 错误级别，仅输出错误
    //   fatal  — 致命错误级别，仅输出导致程序退出的错误
    //   panic  — Panic 级别，仅输出 panic 信息
    // 设置为 trace 可以让你看到最完整的运行细节，便于深度调试
    "level": "trace",

    // 第 4 行：timestamp — 是否在每条日志前添加时间戳
    // true  → 开启，日志格式：2026-07-28 10:00:00 [trace] xxxx
    // false → 关闭，日志格式：[trace] xxxx
    // 建议开启，方便追踪问题发生的时间点
    "timestamp": true

    // 第 4 行结束 — log 对象的大括号将在第 5 行关闭
  },

  // =========================================================================
  // 第 6 行开始：dns — DNS 解析配置模块
  // =========================================================================
  // DNS 是 sing-box 流量分流的**核心**模块[reference:2]
  // 它控制每个域名由哪个 DNS 服务器解析，以及如何处理解析结果
  // DNS 配置结构：servers（服务器列表）+ rules（规则列表）+ 全局参数[reference:3]
  "dns": {

    // -------- 第 7 行：servers — DNS 服务器列表 --------
    // servers 是一个数组，定义所有可用的 DNS 服务器
    // 每个服务器必须有唯一的 tag（标签），供后续规则引用[reference:4]
    // 数组用方括号 [ ] 包裹，每个元素用逗号分隔
    "servers": [

      // ========== 第 8-9 行：DNS 服务器 1 — hosts 静态映射 ==========
      // type: "hosts" — 从预定义列表或系统 hosts 文件读取域名→IP 映射[reference:5]
      // 作用：跳过 DNS 查询，直接返回 IP 地址
      // 优点：加速解析、防止 DNS 污染、确保关键域名始终可解析
      {
        // 第 9 行：type — 服务器类型
        // "hosts" 表示这是一个静态 hosts 解析器
        "type": "hosts",

        // 第 10 行：tag — 唯一标识符
        // 其他规则通过这个 tag 来引用此 DNS 服务器
        // 命名建议：使用有意义的名称，如 hosts_fix、local_dns 等
        "tag": "hosts_fix",

        // 第 11 行开始：predefined — 预定义的域名→IP 映射表
        // 这是一个对象（键值对），键是域名，值是该域名对应的 IP 地址数组
        // 当需要解析这些域名时，直接返回预设的 IP，不发起网络 DNS 查询
        "predefined": {

          // 第 12 行：cloudflare-dns.com → Cloudflare 的 DoH 服务器
          // 1.1.1.1 和 1.0.0.1 是 Cloudflare 的公共 DNS 服务器
          // 数组中有两个 IP，提供冗余和负载均衡
          "cloudflare-dns.com": [
            "1.1.1.1",   // 主 DNS 服务器
            "1.0.0.1"    // 备用 DNS 服务器
          ],

          // 第 13 行：dns.google → Google 的 DoH 服务器
          // 8.8.8.8 和 8.8.4.4 是 Google 的公共 DNS 服务器
          "dns.google": [
            "8.8.8.8",   // 主 DNS 服务器
            "8.8.4.4"    // 备用 DNS 服务器
          ],

          // 第 14 行：dns.alidns.com → 阿里云的 DoH/DoQ 服务器
          // 223.5.5.5 和 223.6.6.6 是阿里云的公共 DNS 服务器
          // 在中国大陆访问速度较快
          "dns.alidns.com": [
            "223.5.5.5", // 主 DNS 服务器
            "223.6.6.6"  // 备用 DNS 服务器
          ],

          // 第 15 行：dns.adguard.com → AdGuard 的 DoH 服务器
          // 94.140.14.15 和 94.140.15.16 是 AdGuard 的公共 DNS 服务器
          // AdGuard DNS 自带广告和追踪器过滤功能
          "dns.adguard.com": [
            "94.140.14.15", // 主 DNS 服务器
            "94.140.15.16"  // 备用 DNS 服务器
          ],

          // 第 16 行：dns.quad9.net → Quad9 的 DoH 服务器
          // 9.9.9.9 和 149.112.112.112 是 Quad9 的公共 DNS 服务器
          // Quad9 主打安全保护，会拦截已知的恶意域名
          "dns.quad9.net": [
            "9.9.9.9",         // 主 DNS 服务器
            "149.112.112.112"  // 备用 DNS 服务器
          ],

          // 第 17 行：cdn.jsdelivr.net → jsDelivr CDN 服务器
          // 这是全球最大的开源 CDN 之一，用于分发规则集文件
          // 预置 IP 可以加速规则集下载，避免 DNS 解析延迟
          "cdn.jsdelivr.net": [
            "104.16.89.20", // CDN 服务器 IP
            "104.16.90.20"  // CDN 备用服务器 IP
          ],

          // 第 18 行：raw.githubusercontent.com → GitHub Raw 内容服务器
          // 用于下载 raw 格式的文件（如规则集、配置文件等）
          // 预置 IP 可以防止 DNS 污染导致无法下载规则集
          "raw.githubusercontent.com": [
            "185.199.108.133", // GitHub Raw 服务器 IP
            "185.199.109.133", // GitHub Raw 备用服务器 IP
            "185.199.110.133", // GitHub Raw 备用服务器 IP
            "185.199.111.133"  // GitHub Raw 备用服务器 IP
          ]

          // 第 18 行结束 — predefined 对象的大括号
        }

        // 第 19 行 — hosts 服务器的大括号关闭
      },

      // ========== 第 20-21 行：DNS 服务器 2 — 本地系统 DNS ==========
      // type: "local" — 读取操作系统的 DNS 设置[reference:6]
      // Linux:   /etc/resolv.conf
      // Windows: 网络适配器中的 DNS 设置
      // macOS:   scutil 命令读取的系统 DNS 配置
      {
        // 第 21 行：type — "local" 表示使用系统 DNS
        "type": "local",

        // 第 22 行：tag — 唯一标识符
        // 后续规则通过 "local-dns" 引用此服务器
        "tag": "local-dns"

        // 第 22 行结束 — local 服务器的大括号关闭
      },

      // ========== 第 23-24 行：DNS 服务器 3 — Fake-IP ==========
      // type: "fakeip" — 返回虚拟 IP 地址，用于代理分流[reference:7]
      // 原理：对需要代理的域名返回 198.18.0.0/15 范围内的虚拟 IP
      // 后续路由规则匹配这些虚拟 IP 时，自动将流量导向代理出站
      // 优点：实现域名级别的分流，无需 SNI 嗅探
      {
        // 第 24 行：type — "fakeip" 表示 Fake-IP 模式
        "type": "fakeip",

        // 第 25 行：tag — 唯一标识符
        "tag": "fakeip",

        // 第 26 行：inet4_range — IPv4 虚拟 IP 地址池
        // 198.18.0.0/15 的范围：198.18.0.0 ~ 198.19.255.255
        // 总共 131072 个 IP 地址，足以容纳大量域名的映射
        // 这些 IP 地址是 RFC 2544 保留的测试专用地址段，不会与公网 IP 冲突
        "inet4_range": "198.18.0.0/15"

        // 第 26 行结束 — fakeip 服务器的大括号关闭
      },

      // ========== 第 27-28 行：DNS 服务器 4 — 阿里 DNS over QUIC ==========
      // type: "quic" — 使用 QUIC 协议（基于 UDP 的 HTTP/3）[reference:8]
      // QUIC 是 Google 开发的传输层协议，具有低延迟、连接复用、抗丢包等优点
      // 阿里 DNS 是国内首个支持 QUIC 的公共 DNS 服务
      {
        // 第 28 行：type — "quic" 表示使用 QUIC 协议
        "type": "quic",

        // 第 29 行：tag — 唯一标识符
        "tag": "alidns-quic",

        // 第 30 行：detour — 指定用于连接此 DNS 服务器的出站[reference:9]
        // "DIRECT" 表示直连，不经过任何代理
        // 这样 DNS 查询请求不会走代理，避免 DNS 泄露和循环依赖
        "detour": "DIRECT",

        // 第 31 行：domain_resolver — 用于解析服务器域名的 DNS 标签[reference:10]
        // 先用 "hosts_fix"（静态 hosts）解析 dns.alidns.com 的 IP
        // 避免通过本 DNS 服务器解析自己的域名（循环依赖问题）
        "domain_resolver": "hosts_fix",

        // 第 32 行：server — DNS 服务器地址[reference:11]
        // 这里是域名格式，sing-box 会通过 domain_resolver 解析它
        "server": "dns.alidns.com"

        // 第 32 行结束 — alidns-quic 服务器的大括号关闭
      },

      // ========== 第 33-34 行：DNS 服务器 5 — Cloudflare DoH ==========
      // type: "https" — DNS over HTTPS（DNS 加密传输）[reference:12]
      // 优点：加密 DNS 查询，防止中间人篡改和窃听
      // Cloudflare 的 1.1.1.1 是全球最快的公共 DNS 之一
      {
        // 第 34 行：type — "https" 表示 DNS over HTTPS
        "type": "https",

        // 第 35 行：tag — 唯一标识符
        "tag": "cf-dns",

        // 第 36 行：detour — 用于连接此 DNS 服务器的出站[reference:13]
        // "📦 sing-box" 是一个出站选择器，通常指向代理节点
        // 这意味着 Cloudflare DoH 查询会通过代理发出
        // 注意：这里的 emoji 是标签名称的一部分，不是注释
        "detour": "📦 sing-box",

        // 第 37 行：domain_resolver — 用于解析服务器域名的 DNS 标签[reference:14]
        "domain_resolver": "hosts_fix",

        // 第 38 行：server — DNS 服务器地址[reference:15]
        "server": "cloudflare-dns.com"

        // 第 38 行结束 — cf-dns 服务器的大括号关闭
      },

      // ========== 第 39-40 行：DNS 服务器 6 — AdGuard DoH ==========
      // type: "https" — DNS over HTTPS
      // AdGuard DNS 自带广告和追踪器过滤，可以在 DNS 层面屏蔽广告
      {
        // 第 40 行：type — "https" 表示 DNS over HTTPS
        "type": "https",

        // 第 41 行：tag — 唯一标识符
        "tag": "adguard-dns",

        // 第 42 行：detour — 用于连接此 DNS 服务器的出站
        "detour": "📦 sing-box",

        // 第 43 行：domain_resolver — 用于解析服务器域名的 DNS 标签
        "domain_resolver": "hosts_fix",

        // 第 44 行：server — DNS 服务器地址
        "server": "dns.adguard.com"

        // 第 44 行结束 — adguard-dns 服务器的大括号关闭
      },

      // ========== 第 45-46 行：DNS 服务器 7 — Quad9 DoH ==========
      // type: "https" — DNS over HTTPS
      // Quad9 主打安全保护，使用多个威胁情报源拦截恶意域名
      {
        // 第 46 行：type — "https" 表示 DNS over HTTPS
        "type": "https",

        // 第 47 行：tag — 唯一标识符
        "tag": "quad9-doh",

        // 第 48 行：detour — 用于连接此 DNS 服务器的出站
        "detour": "📦 sing-box",

        // 第 49 行：domain_resolver — 用于解析服务器域名的 DNS 标签
        "domain_resolver": "hosts_fix",

        // 第 50 行：server — DNS 服务器地址
        "server": "dns.quad9.net"

        // 第 50 行结束 — quad9-doh 服务器的大括号关闭
      },

      // ========== 第 51-52 行：DNS 服务器 8 — Google DoH ==========
      // type: "https" — DNS over HTTPS
      // Google 的 8.8.8.8 是世界上最知名的公共 DNS 之一
      {
        // 第 52 行：type — "https" 表示 DNS over HTTPS
        "type": "https",

        // 第 53 行：tag — 唯一标识符
        "tag": "google-dns",

        // 第 54 行：detour — 用于连接此 DNS 服务器的出站
        "detour": "📦 sing-box",

        // 第 55 行：domain_resolver — 用于解析服务器域名的 DNS 标签
        "domain_resolver": "hosts_fix",

        // 第 56 行：server — DNS 服务器地址
        "server": "dns.google"

        // 第 56 行结束 — google-dns 服务器的大括号关闭
      }

      // 第 57 行 — servers 数组的大括号关闭
    ],

    // -------- 第 58 行开始：rules — DNS 规则列表 --------
    // rules 是一个数组，定义 DNS 查询的匹配和处理规则[reference:16]
    // 规则从上到下依次匹配，先命中先执行
    // 每条规则可以指定匹配条件（domain、rule_set、query_type 等）和执行动作（server、reject 等）
    "rules": [

      // ========== 第 59-60 行：DNS 规则 1 — 屏蔽小米相关域名 ==========
      // 目的：屏蔽小米系域名的 DNS 解析，防止数据上传到小米服务器
      // 匹配条件：域名后缀匹配 + 规则集匹配
      // 执行动作：reject（拒绝解析，返回空响应）
      {
        // 第 60 行：domain_suffix — 匹配域名后缀列表
        // 只要域名以这些后缀结尾，就匹配此规则
        // 例如：api.xiaomi.com、data.miui.com 等都会被匹配
        "domain_suffix": [
          ".xiaomi.com",        // 小米主域名
          ".miui.com",          // MIUI 系统相关
          ".mi.com",            // 小米商城
          ".xiaomiyoupin.com",  // 小米有品
          ".mijia.com"          // 米家智能家居
        ],

        // 第 61 行：rule_set — 额外规则集
        // 除了域名后缀匹配，还必须匹配这些规则集
        // 规则集在 route.rule_set 中定义（见后文）
        "rule_set": [
          "BlockHttpDNS",       // 屏蔽 HTTP DNS 请求
          "AdGuardSDNSFilter",  // AdGuard SDK 过滤列表
          "ads"                 // 广告域名列表
        ],

        // 第 62 行：action — 执行动作
        // "reject" 表示拒绝解析，DNS 查询将返回空响应
        // 效果：这些域名无法被解析，相当于被屏蔽
        "action": "reject"

        // 第 62 行结束 — 规则 1 的大括号关闭
      },

      // ========== 第 63-64 行：DNS 规则 2 — 只允许 IPv4（A 记录） ==========
      // 目的：完全禁用 IPv6，只解析 IPv4 地址
      // 匹配条件：查询类型不是 A（即不是 IPv4 查询）
      // 执行动作：reject（拒绝解析）
      {
        // 第 64 行：query_type — 匹配 DNS 查询类型
        // "A" 表示 IPv4 地址查询
        "query_type": "A",

        // 第 65 行：invert — 反向匹配
        // true 表示匹配条件取反
        // 即：查询类型不是 A 的请求，才匹配此规则
        "invert": true,

        // 第 66 行：action — 执行动作
        // "reject" 表示拒绝解析
        // 效果：所有 AAAA（IPv6）、HTTPS（DNS SVCB）等非 A 查询都被拒绝
        "action": "reject"

        // 第 66 行结束 — 规则 2 的大括号关闭
      },

      // ========== 第 67-68 行：DNS 规则 3 — 广告域名评估（Quad9） ==========
      // 目的：使用 Quad9 DoH 评估域名是否在广告列表中
      // action: "evaluate" — 只评估不响应，结果打上 tag[reference:17]
      // 后续规则通过 match_response 匹配这个 tag 来决定如何处理
      {
        // 第 68 行：rule_set — 匹配规则集
        // "geosite-category-ads-all" 是来自 geosite 的广告域名集合
        // 这个规则集在 route.rule_set 中定义（见后文）
        "rule_set": "geosite-category-ads-all",

        // 第 69 行：action — 执行动作
        // "evaluate" 表示评估但不立即返回结果
        "action": "evaluate",

        // 第 70 行：server — 使用的 DNS 服务器
        // 使用 "quad9-doh" 服务器来解析这个域名
        "server": "quad9-doh",

        // 第 71 行：tag — 标记
        // 此评估结果将被标记为 "ad-q9"
        // 后续规则可以通过 match_response: "ad-q9" 来匹配
        "tag": "ad-q9"

        // 第 71 行结束 — 规则 3 的大括号关闭
      },

      // ========== 第 72-73 行：DNS 规则 4 — 广告域名评估（AdGuard） ==========
      // 目的：使用 AdGuard DoH 评估域名是否在广告列表中
      // 与规则 3 类似，但使用不同的 DNS 服务器，提供冗余
      {
        // 第 73 行：rule_set — 匹配规则集
        // "geosite_adguard" 是 AdGuard 的广告域名集合
        "rule_set": "geosite_adguard",

        // 第 74 行：action — "evaluate" 表示评估
        "action": "evaluate",

        // 第 75 行：server — 使用 "adguard-dns" 服务器解析
        "server": "adguard-dns",

        // 第 76 行：tag — 标记为 "ad-ag"
        "tag": "ad-ag"

        // 第 76 行结束 — 规则 4 的大括号关闭
      },

      // ========== 第 77-78 行：DNS 规则 5 — 广告域名响应（Quad9 结果） ==========
      // 目的：匹配规则 3 的评估结果，对广告域名执行响应
      // match_response 匹配之前 evaluate 的 tag[reference:18]
      {
        // 第 78 行：match_response — 匹配之前评估的 tag
        // 如果某个域名的评估结果是 "ad-q9"（即规则 3 匹配到了广告域名）
        // 则执行此规则
        "match_response": "ad-q9",

        // 第 79 行：action — 执行动作
        // "respond" 表示返回响应（通常返回 0.0.0.0 实现屏蔽）
        "action": "respond",

        // 第 80 行：race — 并发执行
        // true 表示如果有多个匹配的响应规则，并发执行，取最快返回的结果
        "race": true

        // 第 80 行结束 — 规则 5 的大括号关闭
      },

      // ========== 第 81-82 行：DNS 规则 6 — 广告域名响应（AdGuard 结果） ==========
      // 目的：匹配规则 4 的评估结果，对广告域名执行响应
      {
        // 第 82 行：match_response — 匹配 "ad-ag" 标签
        "match_response": "ad-ag",

        // 第 83 行：action — "respond" 返回响应
        "action": "respond",

        // 第 84 行：race — 并发执行
        "race": true

        // 第 84 行结束 — 规则 6 的大括号关闭
      },

      // ========== 第 85-86 行：DNS 规则 7 — 私有网络域名 ==========
      // 目的：私有网络域名（如 .local、.lan 等）使用本地 DNS 解析
      // 这些域名通常只在局域网内有效，不应该走公共 DNS
      {
        // 第 86 行：rule_set — 匹配私有网络域名规则集
        // "private" 规则集包含 .local、.lan、.internal 等私有域名
        "rule_set": "private",

        // 第 87 行：server — 使用的 DNS 服务器
        // 使用 "local-dns"（系统 DNS）解析私有域名
        "server": "local-dns"

        // 第 87 行结束 — 规则 7 的大括号关闭
      },

      // ========== 第 88-89 行：DNS 规则 8 — 国内域名 ==========
      // 目的：中国国内常用域名使用本地 DNS 解析
      // 包括：中国网站、微软国内节点、苹果国内节点、游戏国内节点等
      {
        // 第 89 行：rule_set — 匹配国内域名规则集列表
        "rule_set": [
